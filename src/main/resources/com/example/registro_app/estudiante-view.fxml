<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" minHeight="350.0" minWidth="300.0" spacing="15.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.example.registro_app.EstudianteController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <Label fx:id="welcomeText" text="Registro de Notas de Estudiantes" textAlignment="CENTER" textFill="#00909a" underline="true">
      <VBox.margin>
         <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
      </VBox.margin>
      <font>
         <Font name="Arial Bold" size="13.0" />
      </font>
      <padding>
         <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
      </padding></Label>
   <Label text="Nombre del Estudiante" />
   <TextField fx:id="tfNombre" />
   <Label text="Nota" />
   <TextField fx:id="tfNota" />
   <Button fx:id="btnGuardar" mnemonicParsing="false" text="Guardar" />
   <Label fx:id="lblPromedio" text="Promedio: 0" />
</VBox>
